{
  "manifest_version": 3,
  "name": "JobTailor Auto-Track",
  "version": "0.1.0",
  "description": "Detects job applications on Greenhouse, Lever, Ashby, and Workday, and offers to add them to your JobTailor tracker.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:5000/*", "https://*.onrender.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobTailor Auto-Track"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
