# ============================================
# JobTailor — Environment Variables Template
# ============================================
# Copy this to apps/server/.env and fill in values
# Copy apps/client/.env.example to apps/client/.env.client

# --- Server (.env) ---

# App
PORT=5000
NODE_ENV=development

# MongoDB Atlas (get free tier at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/jobtailor?retryWrites=true&w=majority

# JWT Authentication (generate strong secrets: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRE=7d

# Password Hashing
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173

# ─── Multi-Provider AI Configuration ──────────────────────────────────────
# JobTailor supports multiple AI providers with automatic fallback.
# At least ONE provider must be configured for production.
#
# Preferred provider order (set PREFERRED_AI_PROVIDER to prioritize):
# - openai  : OpenAI GPT-4o-mini (recommended for best quality)
# - gemini  : Google Gemini 1.5 Flash (good quality, cost-effective)
# - nvidia  : NVIDIA NIM (Llama 3 70B) via your NIM endpoint
#
# Fallback Strategy: If the preferred provider fails, automatically tries
# the next available provider in the order: preferred → openai → gemini → nvidia

OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-20b
PREFERRED_AI_PROVIDER=openai

# Cloudinary (for PDF/resume storage - get free at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=jobtailor/resumes

# ─── Email (SMTP) Configuration ──────────────────────────────────────────────
# REQUIRED for production password reset emails.
# Works with any SMTP provider: Gmail, Outlook, SendGrid, Mailgun, Postmark, custom SMTP, etc.
# For Gmail: Use App Password (not regular password) - https://myaccount.google.com/apppasswords
# For development without SMTP: Emails will be logged to console instead

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@jobtailor.app
EMAIL_FROM_NAME=JobTailor
FRONTEND_URL=http://localhost:5173

# --- Client (.env.client) ---
# See apps/client/.env.example